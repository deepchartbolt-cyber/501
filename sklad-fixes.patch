index 2bfe5c1..08ed16b 100644
--- a/src/modules/admin/api.ts
+++ b/src/modules/admin/api.ts
@@ -381,3 +381,13 @@ export async function deleteItem(id: number): Promise<void> {
   const { error } = await supabase.from('items').delete().eq('id', id)
   if (error) throw new Error(error.message)
 }
+
+// Есть ли по позиции движения склада или нормы: тогда единицу измерения менять нельзя
+export async function itemHasHistory(itemId: number): Promise<boolean> {
+  const moves = await supabase.from('stock_moves').select('id', { count: 'exact', head: true }).eq('item_id', itemId)
+  if (moves.error) throw new Error(moves.error.message)
+  if ((moves.count ?? 0) > 0) return true
+  const norms = await supabase.from('norm_rules').select('id', { count: 'exact', head: true }).eq('item_id', itemId)
+  if (norms.error) throw new Error(norms.error.message)
+  return (norms.count ?? 0) > 0
+}
